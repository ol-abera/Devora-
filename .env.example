# Base URL of the Express API. Keep "/api" in dev (Vite proxies it to VITE_PROXY_TARGET).
VITE_API_URL=/api
# Where Vite's dev proxy sends /api requests (your friends' Express server)
VITE_PROXY_TARGET=http://localhost:4000
# true = run fully in the browser with a fake backend (no Express needed). false = call the real API.
VITE_USE_MOCK=true

# Google Identity Services client ID (OAuth 2.0 Web client). Leave empty in mock mode.
VITE_GOOGLE_CLIENT_ID=
